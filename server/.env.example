# ─────────────────────────────────────────────────────────────
# ConfigDrift — Server Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Option 1: Local MongoDB (development)
MONGODB_URI=mongodb://127.0.0.1:27017/configdrift

# Option 2: MongoDB Atlas (production — free cloud cluster)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/configdrift?retryWrites=true&w=majority

# Security — CHANGE THIS to a long random string in production (min 32 chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret-string

# Token Expiry
JWT_EXPIRES_IN=7d

# Frontend URL for CORS (set to your Vercel URL in production)
CLIENT_URL=http://localhost:5173
