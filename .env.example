# ─────────────────────────────────────────────────────────────
# ConfigDrift — Root .env.example
# This file documents all environment variables used in the project.
# ─────────────────────────────────────────────────────────────
# Copy server/.env.example → server/.env and fill in your values.
# Copy client/.env.example → client/.env for frontend (optional in dev).

# ── Backend (server/.env) ──────────────────────────────────────
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/configdrift
JWT_SECRET=replace-this-with-a-long-random-secret-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# ── Frontend (client/.env) — only needed for production build ──
VITE_API_URL=https://your-backend.onrender.com
