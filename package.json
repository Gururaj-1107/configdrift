{
  "name": "configdrift",
  "version": "1.0.0",
  "description": "ConfigDrift — Environment Configuration Validator for Dev, Test, and Prod",
  "main": "server/src/server.js",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --prefix client",
    "seed": "npm run seed --prefix server",
    "db:check": "npm run db:check --prefix server",
    "test:server": "npm test --prefix server",
    "test": "npm run test:server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "ConfigDrift Team",
  "license": "ISC"
}
