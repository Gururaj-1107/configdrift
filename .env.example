# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB by default, or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/configdrift

# Security
JWT_SECRET=replace_this_with_a_secure_jwt_secret_in_development
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
